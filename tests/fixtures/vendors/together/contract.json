    "generation": "https://api.together.ai/v1/chat/completions",
    "embeddings": "https://api.together.ai/v1/embeddings",
    "rerank": "https://api.together.ai/v1/rerank"
  },
  "unsupported_parameters": [
    "logit_bias",
    "metadata",
    "prediction",
    "service_tier",
    "store",
    "truncation"
  ],
