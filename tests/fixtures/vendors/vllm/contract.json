{
  "vendor": "vllm",
  "documentation_url": "https://docs.vllm.ai/en/latest/serving/online_serving/openai_compatible_server/",
  "reviewed_at": "2026-10-05",
  "notes": "Self-hosted. The error shape follows vLLM's protocol source; user is accepted and ignored. Usage arrives in streams with stream_options.include_usage.",
  "endpoints": {
    "generation": "https://vllm.example.internal/v1/chat/completions",
    "embeddings": "https://vllm.example.internal/v1/embeddings"
  },
  "unsupported_parameters": [
    "user"
  ],
  "responses": {
    "generation": {
      "file": "chat.response.json",
      "basis": "schema",
      "usage": {
        "input_tokens": 9,
        "output_tokens": 3,
        "total_tokens": 12
      }
    }
  },
  "stream": {
    "file": "chat.stream.sse",
    "basis": "schema",
    "text": "Hello",
    "usage": {
      "input_tokens": 9,
      "output_tokens": 1,
      "total_tokens": 10
    }
  },
  "error": {
    "file": "error.json",
    "basis": "schema",
    "status": 404,
    "envelope": {
      "type": "NotFoundError",
      "code": "404",
      "message": "The model `x` does not exist."
    },
    "class": "upstream_client"
  }
}
