{
  "vendor": "docker-model-runner",
  "documentation_url": "https://docs.docker.com/ai/model-runner/api-reference/",
  "reviewed_at": "2026-10-05",
  "notes": "Self-hosted; ignores the Authorization header. The model list shape is undocumented, so models are declared. Only max_tokens is documented.",
  "endpoints": {
    "generation": "https://model-runner.example.internal/engines/v1/chat/completions",
    "embeddings": "https://model-runner.example.internal/engines/v1/embeddings"
  },
  "unsupported_parameters": [],
  "responses": {
    "generation": {
      "file": "chat.response.json",
      "basis": "dialect",
      "usage": {
        "input_tokens": 9,
        "output_tokens": 3,
        "total_tokens": 12
      }
    }
  },
  "stream": {
    "file": "chat.stream.sse",
    "basis": "dialect",
    "text": "Hello",
    "usage": {
      "input_tokens": 9,
      "output_tokens": 1,
      "total_tokens": 10
    }
  },
  "error": {
    "file": "error.json",
    "basis": "dialect",
    "status": 400,
    "envelope": {
      "type": "invalid_request_error",
      "code": "",
      "message": "The request is invalid."
    },
    "class": "upstream_client"
  }
