  "reviewed_at": "2026-10-05",
  "notes": "Self-hosted; --api-key enables Bearer authentication. /v1/models always has one element. The rerank response shape is undocumented, so rerank is not reviewed.",
  "endpoints": {
    "generation": "https://llamacpp.example.internal/v1/chat/completions",
