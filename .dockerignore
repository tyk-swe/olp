**/credentials/**
**/.cargo/credentials.toml
**/secrets
**/secrets/**
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.dump
**/*.dump.*
target
**/target
**/target/**
**/node_modules
**/node_modules/**
backups
backups/**
*.profraw
*.profdata
lcov.info
**/*.spdx.json
**/*.sarif
coverage
**/coverage
**/coverage/**
fuzz/artifacts
fuzz/artifacts/**
console/.svelte-kit
console/.storybook
console/build
console/node_modules
console/.vite
console/.vite/**
console/playwright.config.ts
console/playwright.integration.config.ts
console/playwright.screenshots.config.ts
console/playwright.storybook.config.ts
console/vite.console-preview.config.ts
