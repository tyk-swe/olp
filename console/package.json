{
  "name": "@openllmproxy/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/asset-manifest.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint .",
    "test": "svelte-kit sync && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript ../openapi/management.json -o src/lib/api/schema.d.ts && node scripts/generate-requirements.mjs",
    "verify": "pnpm format:check && pnpm check && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/svelte-query": "^6.3.6",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
