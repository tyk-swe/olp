{
  "name": "@openllmproxy/console",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/asset-manifest.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && eslint .",
    "test": "vitest run",
    "test:e2e": "svelte-kit sync && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript ../openapi/management.json -o src/lib/api/schema.d.ts",
    "verify": "pnpm format:check && pnpm check && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/svelte-query": "^6.1.48",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  }
}
