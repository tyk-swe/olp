{
  "paths": {
    "/api/v1/invitations": {
      "get": {
        "operationId": "list_invitations",
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationListResponse"
                }
              }
            },
            "description": "Invitation history"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed query parameters, or an invalid cursor or page size"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "access_read",
              "installation"
            ]
          },
          {
            "managementToken": [
              "access_read",
              "installation"
            ]
          }
        ],
        "tags": [
          "invitations"
        ]
      },
      "post": {
        "operationId": "create_invitation",
        "parameters": [
          {
            "description": "Unique invitation creation key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInvitationResponse"
                }
              }
            },
            "description": "Invitation created; token is displayed once",
            "headers": {
              "Location": {
                "description": "Path of the created resource",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key is missing or invalid"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Member, pending invitation, or idempotency conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invitation is invalid"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Master key or database unavailable"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "access",
              "installation"
            ]
          },
          {
            "managementToken": [
              "access",
              "installation"
            ]
          }
        ],
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/v1/invitations/accept": {
      "post": {
        "operationId": "accept_invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Invitation accepted and authenticated session created"
          },
          "202": {
            "description": "Password verified; no session or recent grant is issued until MFA completes. Enrollment is required when the installation policy requires it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/MFAChallenge"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Email is already a member"
          },
          "410": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invitation is invalid, expired, revoked, or accepted"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Password or display name is invalid"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Password work is rate limited"
          }
        },
        "security": [],
        "tags": [
          "invitations"
        ]
      }
    },
    "/api/v1/invitations/{invitation_id}": {
      "delete": {
        "operationId": "revoke_invitation",
        "parameters": [
          {
            "description": "Invitation ID",
            "in": "path",
            "name": "invitation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Unique invitation revocation key",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationResponse"
                }
              }
            },
            "description": "Invitation revoked; an identical retry replays this response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Idempotency-Key is missing or invalid"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invitation is already accepted or revoked, or the Idempotency-Key was already used for a different request"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "access",
              "installation"
            ]
          },
          {
            "managementToken": [
              "access",
              "installation"
            ]
          }
        ],
        "tags": [
          "invitations"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "properties": {
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "token": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "display_name",
          "password"
        ],
        "type": "object"
      },
      "CreateInvitationRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "expires_in_hours": {
            "description": "Invitation lifetime in hours, from 1 to 720. Defaults to seven days (168)\nand is capped at thirty days.",
            "format": "int32",
            "maximum": 720,
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "type": "object"
      },
      "CreateInvitationResponse": {
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/InvitationResponse"
          },
          "token": {
            "description": "Returned only by the invitation-creation response.",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "invitation",
          "token"
        ],
        "type": "object"
      },
      "InvitationListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InvitationResponse"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "InvitationResponse": {
        "properties": {
          "accepted_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "accepted_by_email": {
            "description": "Email of the account created by accepting the invitation.",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "invited_by": {
            "format": "uuid",
            "type": "string"
          },
          "invited_by_email": {
            "description": "Email of the operator who sent the invitation.",
            "type": [
              "string",
              "null"
            ]
          },
          "revoked_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "revoked_by_email": {
            "description": "Email of the operator who revoked the invitation.",
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "invited_by",
          "status",
          "expires_at",
          "created_at"
        ],
        "type": "object"
      }
    }
  }
}
