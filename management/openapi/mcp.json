{
  "paths": {
    "/api/v1/mcp-executables": {
      "get": {
        "description": "Review deployment-installed executable metadata without running it, or manage permission for its exact digest. Native execution requires owner approval and recent authentication with explicit risk acknowledgment.",
        "operationId": "listMCPExecutables",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPExecutableList"
                }
              }
            },
            "description": "Executables, by name"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Caller is not a session-authenticated owner"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The native executable tier is disabled or the installed executable is unavailable"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "OLP can't read the unconfined plugin directory the deployment names (unconfined_plugin_dir_unreadable)"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "manage_plugins",
              "installation"
            ]
          }
        ],
        "tags": [
          "mcp"
        ],
        "summary": "Manage an installed MCP executable"
      }
    },
    "/api/v1/mcp-executables/{executable}/review": {
      "post": {
        "description": "Review deployment-installed executable metadata without running it, or manage permission for its exact digest. Native execution requires owner approval and recent authentication with explicit risk acknowledgment.",
        "operationId": "reviewMCPExecutable",
        "parameters": [
          {
            "description": "File name of the executable in the unconfined plugin directory",
            "in": "path",
            "name": "executable",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPExecutablePermission"
                }
              }
            },
            "description": "Installed executable metadata and digest permission, without starting the executable"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Caller is not a session-authenticated owner"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The native executable tier is disabled or the installed executable is unavailable"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Executable metadata or the required risk acknowledgment is invalid"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "manage_plugins",
              "installation"
            ]
          }
        ],
        "tags": [
          "mcp"
        ],
        "summary": "Manage an installed MCP executable"
      }
    },
    "/api/v1/mcp-executables/{executable}/permit": {
      "post": {
        "description": "Review deployment-installed executable metadata without running it, or manage permission for its exact digest. Native execution requires owner approval and recent authentication with explicit risk acknowledgment.",
        "operationId": "permitMCPExecutable",
        "parameters": [
          {
            "description": "File name of the executable in the unconfined plugin directory",
            "in": "path",
            "name": "executable",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./shared.json#/components/schemas/UnconfinedPluginPermitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MCPExecutablePermission"
                }
              }
            },
            "description": "Unconfined plugin permitted",
            "headers": {
              "ETag": {
                "description": "Current plugin ETag",
                "schema": {
                  "type": "string"
                }
              },
              "Location": {
                "description": "The permitted plugin",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Caller is not a session-authenticated owner"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The native executable tier is disabled or the installed executable is unavailable"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The executable changed since the owner reviewed it (plugin_executable_changed), or this build is already permitted (plugin_permitted)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Executable metadata or the required risk acknowledgment is invalid"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The owner has not reauthenticated for plugin_permit (reauthentication_required)"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "manage_plugins",
              "installation"
            ]
          }
        ],
        "tags": [
          "mcp"
        ],
        "summary": "Manage an installed MCP executable"
      }
    },
    "/api/v1/mcp-executables/{executable}/permissions/{digest}": {
      "delete": {
        "description": "Review deployment-installed executable metadata without running it, or manage permission for its exact digest. Native execution requires owner approval and recent authentication with explicit risk acknowledgment.",
        "operationId": "revokeMCPExecutable",
        "parameters": [
          {
            "description": "File name of the executable in the unconfined plugin directory",
            "in": "path",
            "name": "executable",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "digest",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Permission revoked"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Caller is not a session-authenticated owner"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The native executable tier is disabled or the installed executable is unavailable"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The executable changed since the owner reviewed it (plugin_executable_changed), or this build is already permitted (plugin_permitted)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Executable metadata or the required risk acknowledgment is invalid"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "The owner has not reauthenticated for plugin_permit (reauthentication_required)"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "manage_plugins",
              "installation"
            ]
          }
        ],
        "tags": [
          "mcp"
        ],
        "summary": "Manage an installed MCP executable"
      }
    }
  },
  "components": {
    "schemas": {
      "MCPExecutableFile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest",
          "size_bytes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MCPExecutablePermission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest",
          "size_bytes",
          "permitted"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "permitted": {
            "type": "boolean"
          }
        }
      },
      "MCPExecutableList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MCPExecutableFile"
            }
          }
        }
      }
    }
  }
}
