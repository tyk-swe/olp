{
  "paths": {
    "/api/v1/execution-debits": {
      "get": {
        "operationId": "list_execution_debits",
        "tags": [
          "budgets"
        ],
        "summary": "list execution debits",
        "description": "Provisional financial exposure, reported separately from observed usage and invoice charges.",
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "name": "api_key_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
