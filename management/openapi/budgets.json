                  "$ref": "#/components/schemas/ExecutionDebitList"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Observed registration or revision identity",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Outside caller authority"
          },
          "404": {
            "description": "Not visible"
          },
          "409": {
            "description": "Retired or conflicting name"
          },
          "412": {
            "description": "Stale observed registration"
          },
          "422": {
            "description": "Invalid definition or upstream certification"
          },
          "428": {
            "description": "Observed ETag required"
          }
        }
      }
    }
  },
