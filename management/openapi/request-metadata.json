{
  "paths": {
    "/api/v1/request-metadata/gateway-epochs": {
      "get": {
        "operationId": "list_request_metadata_gateway_epochs",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Filter by open, gracefully_closed, unresolved, or acknowledged.",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestMetadataGatewayEpochListResponse"
                }
              }
            },
            "description": "Request metadata gateway process epoch page"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid cursor or state filter"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "usage",
              "installation"
            ]
          },
          {
            "managementToken": [
              "usage",
              "installation"
            ]
          }
        ],
        "tags": [
          "request-metadata"
        ]
      }
    },
    "/api/v1/request-metadata/gateway-epochs/{process_epoch}/acknowledge": {
      "post": {
        "operationId": "acknowledge_request_metadata_gateway_epoch",
        "parameters": [
          {
            "in": "path",
            "name": "process_epoch",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestMetadataEpochAcknowledgementResponse"
                }
              }
            },
            "description": "Unclean gateway epoch acknowledged; retained completeness evidence is unchanged"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Unclean gateway epoch not found"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "settings",
              "installation"
            ]
          },
          {
            "managementToken": [
              "settings",
              "installation"
            ]
          }
        ],
        "tags": [
          "request-metadata"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RequestMetadataEpochAcknowledgementResponse": {
        "properties": {
          "acknowledged_at": {
            "format": "date-time",
            "type": "string"
          },
          "acknowledged_by": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "gateway_instance": {
            "type": "string"
          },
          "process_epoch": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "process_epoch",
          "gateway_instance",
          "acknowledged_at"
        ],
        "type": "object"
      },
      "RequestMetadataGatewayEpochListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RequestMetadataGatewayEpochResponse"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "RequestMetadataGatewayEpochResponse": {
        "properties": {
          "abandoned": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "accepted": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "acknowledged_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "acknowledged_by": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "dropped": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "gateway_instance": {
            "type": "string"
          },
          "gracefully_closed_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "persisted": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "process_epoch": {
            "format": "uuid",
            "type": "string"
          },
          "retrying": {
            "type": "boolean"
          },
          "stale_detected_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "uncertain_event_lower_bound": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "uncertainty_gap_id": {
            "description": "Ingestion gap opened for the events this epoch could not account for.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "writer_closed": {
            "type": "boolean"
          }
        },
        "required": [
          "gateway_instance",
          "process_epoch",
          "state",
          "started_at",
          "updated_at",
          "accepted",
          "persisted",
          "dropped",
          "abandoned",
          "uncertain_event_lower_bound",
          "retrying",
          "writer_closed"
        ],
        "type": "object"
      }
    }
  }
}
