          "403": {
            "description": "Outside caller authority"
          },
          "404": {
            "description": "Not visible"
          },
          "409": {
            "description": "Retired or conflicting name"
          },
          "412": {
            "description": "Stale observed registration"
          },
          "422": {
            "description": "Invalid binding, target, field mapping or key grants"
          },
          "428": {
            "description": "Observed ETag required"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetrievalBindingInput"
              }
            }
          }
        }
      }
    },
