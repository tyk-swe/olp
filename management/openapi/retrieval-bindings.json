  "components": {
    "schemas": {
      "RetrievalBindingInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "route": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          },
          "backend": {
            "type": "string",
            "enum": [
              "bedrock_knowledge_base",
              "vertex_rag",
              "azure_ai_search"
            ]
          },
          "backend_resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "fields": {
            "$ref": "./shared.json#/components/schemas/RetrievalBindingFields"
          },
          "key_grants": {
            "type": "array",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Explicit active API-key UUIDs in this binding project; an empty list grants no access."
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "project_id",
          "name",
          "route",
          "target_id",
          "backend",
          "backend_resource",
          "fields",
          "key_grants",
          "enabled"
        ]
      },
      "RetrievalBindingResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "route": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          },
          "backend": {
            "type": "string",
            "enum": [
              "bedrock_knowledge_base",
              "vertex_rag",
              "azure_ai_search"
            ]
          },
          "backend_resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "fields": {
            "$ref": "./shared.json#/components/schemas/RetrievalBindingFields"
          },
          "key_grants": {
            "type": "array",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Explicit active API-key UUIDs in this binding project; an empty list grants no access."
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "format": "uuid"
          },
          "retired_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "provider_id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true,
            "description": "Serving connection derived from the selected target; caller input cannot authorize a different connection."
          }
        },
        "required": [
          "project_id",
          "name",
          "route",
          "target_id",
          "backend",
          "backend_resource",
          "fields",
          "key_grants",
          "enabled",
          "id",
          "revision_id",
          "revision",
          "etag",
          "retired_at",
          "provider_id"
        ]
      },
      "RetrievalBindingListResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RetrievalBindingResponse"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "RetrievalBindingRevisionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "definition": {
            "$ref": "#/components/schemas/RetrievalBindingInput"
          }
        },
        "required": [
          "id",
          "binding_id",
          "revision",
          "definition"
        ]
      }
    }
  }
