{
  "paths": {
    "/api/v1/retrieval-bindings": {
      "get": {
        "operationId": "list_retrieval_bindings",
        "tags": [
          "retrieval-bindings"
        ],
        "summary": "list retrieval bindings",
        "description": "Project-owned query-only binding for an operator-managed Knowledge Base, RAG corpus or search index. Configure permission and project-change authority are required for writes. Every revision pins explicit API-key grants, one route target, native backend resource and field mappings. Queries require current published certified provider authority. Index creation and synchronization are excluded.",
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Binding or revision metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetrievalBindingListResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Observed registration or revision identity",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Outside caller authority"
          },
          "404": {
            "description": "Not visible"
          },
          "409": {
            "description": "Retired or conflicting name"
          },
          "412": {
            "description": "Stale observed registration"
          },
          "422": {
            "description": "Invalid binding, target, field mapping or key grants"
          },
          "428": {
            "description": "Observed ETag required"
          }
        }
      },
