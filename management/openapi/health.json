{
  "paths": {
    "/api/v1/health/ready": {
      "get": {
        "operationId": "management_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Cached readiness snapshot for an authenticated management session"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Insufficient role"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Readiness snapshot is stale or unavailable"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/provider-health": {
      "get": {
        "operationId": "provider_health",
        "parameters": [
          {
            "in": "query",
            "name": "window_minutes",
            "required": false,
            "schema": {
              "default": 15,
              "format": "int32",
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderHealthResponse"
                }
              }
            },
            "description": "Probe and rolling-attempt provider health"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed query parameters, or an invalid cursor or page size"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Insufficient role"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "tags": [
          "health"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "asynchronous_plane": {
            "type": "string"
          },
          "asynchronous_plane_current": {
            "type": "boolean"
          },
          "asynchronous_plane_drained": {
            "type": "boolean"
          },
          "asynchronous_plane_last_progress_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "database": {
            "type": "string"
          },
          "generation": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "limits": {
            "type": "string"
          },
          "media_reconciliation": {
            "type": "string"
          },
          "media_reconciliation_failed": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "media_reconciliation_gaps_total": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "media_reconciliation_pending": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "media_reconciliation_stale": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "media_spool_capacity_bytes": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "media_spool_used_bytes": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "request_metadata_complete": {
            "type": "boolean"
          },
          "request_metadata_consumer": {
            "type": "string"
          },
          "request_metadata_consumer_checked_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "request_metadata_consumer_heartbeat_age_seconds": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "request_metadata_consumer_lag_events": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "request_metadata_consumer_oldest_pending_age_seconds": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "request_metadata_consumer_oldest_pending_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "request_metadata_consumer_pending_events": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "request_metadata_duplicate_persistence_total": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "request_metadata_gateway_open_epochs": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "request_metadata_gateway_unresolved_epochs": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "request_metadata_gateway_unresolved_event_lower_bound": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "request_metadata_historical_uncertain_gaps": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "request_metadata_reclaimed_events_total": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "request_metadata_recovered_events_total": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "worker_tasks_stale": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "worker_tasks_unknown": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "status",
          "asynchronous_plane",
          "asynchronous_plane_current",
          "asynchronous_plane_drained",
          "worker_tasks_stale",
          "worker_tasks_unknown",
          "database",
          "limits",
          "request_metadata_complete",
          "request_metadata_consumer",
          "request_metadata_consumer_pending_events",
          "request_metadata_consumer_lag_events",
          "request_metadata_gateway_open_epochs",
          "request_metadata_gateway_unresolved_epochs",
          "request_metadata_historical_uncertain_gaps",
          "request_metadata_gateway_unresolved_event_lower_bound",
          "media_reconciliation",
          "media_reconciliation_pending",
          "media_reconciliation_stale",
          "media_reconciliation_failed",
          "media_reconciliation_gaps_total"
        ],
        "type": "object"
      },
      "ProviderHealthItem": {
        "properties": {
          "attempt_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "average_latency_ms": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "last_attempt_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "last_probe_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "last_probe_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_probe_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_id": {
            "format": "uuid",
            "type": "string"
          },
          "provider_kind": {
            "$ref": "./shared.json#/components/schemas/ProviderKind"
          },
          "provider_name": {
            "type": "string"
          },
          "provider_state": {
            "type": "string"
          },
          "rate_limit_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "server_error_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "success_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "transport_error_count": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "circuit_open_until": {
            "description": "When the fleet-shared circuit closes, while one is open. Gateways order the provider's targets last until then.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "active_probe": {
            "description": "Latest active health probe of the provider.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProviderProbeResult"
              }
            ]
          }
        },
        "required": [
          "provider_id",
          "provider_name",
          "provider_kind",
          "provider_state",
          "status",
          "attempt_count",
          "success_count",
          "rate_limit_count",
          "server_error_count",
          "transport_error_count",
          "circuit_open_until",
          "active_probe"
        ],
        "type": "object"
      },
      "ProviderHealthResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProviderHealthItem"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "window_minutes": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "shared_state": {
            "description": "current: circuit and probe fields come from the fleet's shared state. unconfigured: no shared state is configured. unavailable: it could not be read.",
            "enum": [
              "current",
              "unconfigured",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "window_minutes",
          "items",
          "shared_state"
        ],
        "type": "object"
      },
      "ProviderProbeResult": {
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "type": "string"
          },
          "class": {
            "description": "Failure class of an unhealthy probe.",
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "latency_ms": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "status",
          "class",
          "model",
          "observed_at",
          "latency_ms"
        ],
        "type": "object"
      }
    }
  }
}
