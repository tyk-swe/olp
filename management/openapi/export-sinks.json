{
  "paths": {
    "/api/v1/sinks": {
      "get": {
        "operationId": "list_sinks",
        "tags": [
          "export-sinks"
        ],
        "summary": "list sinks",
        "description": "Read visible export sink metadata; credentials are never returned.",
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SinkListResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Caller lacks authority"
          },
          "404": {
            "description": "Resource not visible"
          },
          "409": {
            "description": "Conflicting retained state"
          },
          "412": {
            "description": "Stale resource ETag"
          },
          "422": {
            "description": "Invalid sink definition"
          },
          "428": {
            "description": "Observed If-Match required"
          }
        }
      },
      "post": {
        "operationId": "create_sink",
        "tags": [
          "export-sinks"
        ],
        "summary": "create sink",
        "description": "Manage a content-free export sink through ordinary scope authority, ETags, idempotency and audit. The managed.runs and managed.trace_spans webhooks describe the corresponding evidence envelopes.",
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "keys"
            ]
          },
          {
            "csrfToken": [],
            "sessionCookie": [
              "settings",
              "installation"
            ]
          },
          {
            "managementToken": [
              "keys"
            ]
          },
          {
            "managementToken": [
              "settings",
              "installation"
            ]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSinkRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SinkResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Caller lacks authority"
          },
          "404": {
            "description": "Resource not visible"
          },
          "409": {
            "description": "Conflicting retained state"
          },
          "412": {
            "description": "Stale resource ETag"
          },
          "422": {
            "description": "Invalid sink definition"
          },
          "428": {
            "description": "Observed If-Match required"
          }
        }
      }
    },
    "/api/v1/sinks/{sink_id}": {
      "get": {
        "operationId": "get_sink",
        "tags": [
          "export-sinks"
        ],
        "summary": "get sink",
        "description": "Read visible export sink metadata; credentials are never returned.",
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "sink_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SinkResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Caller lacks authority"
          },
          "404": {
            "description": "Resource not visible"
          },
          "409": {
            "description": "Conflicting retained state"
          },
          "412": {
            "description": "Stale resource ETag"
          },
          "422": {
            "description": "Invalid sink definition"
          },
          "428": {
            "description": "Observed If-Match required"
          }
        }
      },
      "put": {
        "operationId": "update_sink",
        "tags": [
          "export-sinks"
        ],
        "summary": "update sink",
        "description": "Manage a content-free export sink through ordinary scope authority, ETags, idempotency and audit.",
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "keys"
            ]
          },
          {
            "csrfToken": [],
            "sessionCookie": [
              "settings",
              "installation"
            ]
          },
          {
            "managementToken": [
              "keys"
            ]
          },
          {
            "managementToken": [
              "settings",
              "installation"
            ]
          }
        ],
        "parameters": [
          {
            "name": "sink_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSinkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SinkResponse"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Caller lacks authority"
          },
          "404": {
            "description": "Resource not visible"
          },
          "409": {
            "description": "Conflicting retained state"
          },
          "412": {
            "description": "Stale resource ETag"
          },
          "422": {
            "description": "Invalid sink definition"
          },
          "428": {
            "description": "Observed If-Match required"
          }
        }
      },
      "delete": {
        "operationId": "delete_sink",
        "tags": [
          "export-sinks"
        ],
        "summary": "delete sink",
        "description": "Manage a content-free export sink through ordinary scope authority, ETags, idempotency and audit.",
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "keys"
            ]
          },
          {
            "csrfToken": [],
            "sessionCookie": [
              "settings",
              "installation"
            ]
          },
          {
            "managementToken": [
              "keys"
            ]
          },
          {
            "managementToken": [
              "settings",
              "installation"
            ]
          }
        ],
        "parameters": [
          {
            "name": "sink_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Caller lacks authority"
          },
          "404": {
            "description": "Resource not visible"
          },
          "409": {
            "description": "Conflicting retained state"
          },
          "412": {
            "description": "Stale resource ETag"
          },
          "422": {
            "description": "Invalid sink definition"
          },
          "428": {
            "description": "Observed If-Match required"
          }
        }
      }
    }
  },
  "webhooks": {
    "managed.runs": {
      "post": {
        "summary": "Managed sink run evidence",
        "operationId": "managed_run_evidence_webhook",
        "tags": [
          "export-sinks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagedRunEvidenceEvent"
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "The destination accepted the delivery."
          }
        }
      }
    },
    "managed.trace_spans": {
      "post": {
        "summary": "Managed sink trace span evidence",
        "operationId": "managed_trace_span_evidence_webhook",
        "tags": [
          "export-sinks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManagedTraceSpanEvidenceEvent"
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "The destination accepted the delivery."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSinkRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "destination",
          "streams",
          "enabled"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "destination": {
            "type": "string",
            "maxLength": 2048
          },
          "streams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "requests",
                "attempts",
                "guardrail_decisions",
                "audit",
                "runs",
                "trace_spans"
              ]
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "credential": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "writeOnly": true,
            "description": "HMAC signing credential; omitted updates retain it and null removes it."
          },
          "type": {
            "type": "string",
            "enum": [
              "https"
            ]
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "UpdateSinkRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "destination",
          "streams",
          "enabled"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "destination": {
            "type": "string",
            "maxLength": 2048
          },
          "streams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "requests",
                "attempts",
                "guardrail_decisions",
                "audit",
                "runs",
                "trace_spans"
              ]
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "credential": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "writeOnly": true,
            "description": "HMAC signing credential; omitted updates retain it and null removes it."
          }
        }
      },
      "SinkResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "name",
          "type",
          "destination",
          "streams",
          "enabled",
          "has_credential",
          "etag",
          "retired_at",
          "delivery"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "destination": {
            "type": "string",
            "maxLength": 2048
          },
          "streams": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "requests",
                "attempts",
                "guardrail_decisions",
                "audit",
                "runs",
                "trace_spans"
              ]
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "https"
            ]
          },
          "has_credential": {
            "type": "boolean"
          },
          "etag": {
            "type": "string"
          },
          "retired_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delivered",
              "failed",
              "expired",
              "last_delivered_at"
            ],
            "properties": {
              "delivered": {
                "type": "integer",
                "format": "int64"
              },
              "failed": {
                "type": "integer",
                "format": "int64"
              },
              "expired": {
                "type": "integer",
                "format": "int64"
              },
              "last_delivered_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "SinkListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SinkResponse"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ManagedRunEvidence": {
        "type": "object",
        "description": "Gateway-observed run metadata exported by a managed sink.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_origin": {
            "type": "string",
            "enum": [
              "gateway_observed"
            ]
          }
        },
        "required": [
          "id",
          "project_id",
          "api_key_id",
          "created_at",
          "evidence_origin"
        ]
      },
      "ManagedTraceSpanEvidence": {
        "type": "object",
        "description": "Client-asserted trace span metadata exported by a managed sink. Nanosecond timestamps are decimal strings.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "trace_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "span_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "parent_span_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{16}$"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "attempt_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "started_nanos": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "ended_nanos": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "category": {
            "type": "string",
            "enum": [
              "chat",
              "embeddings",
              "text_completion",
              "execute_tool",
              "invoke_agent",
              "create_agent",
              "other"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gen_ai.usage.input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "gen_ai.usage.output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "http.response.status_code": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          },
          "evidence_origin": {
            "type": "string",
            "enum": [
              "client_asserted"
            ]
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "project_id",
          "trace_id",
          "span_id",
          "parent_span_id",
          "run_id",
          "attempt_id",
          "started_nanos",
          "ended_nanos",
          "category",
          "status",
          "attributes",
          "evidence_origin",
          "api_key_id",
          "received_at"
        ]
      },
      "ManagedRunEvidenceEvent": {
        "type": "object",
        "description": "Managed sink evidence envelope.",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stream": {
            "type": "string",
            "enum": [
              "runs"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "$ref": "#/components/schemas/ManagedRunEvidence"
          }
        },
        "required": [
          "version",
          "id",
          "stream",
          "occurred_at",
          "data"
        ]
      },
      "ManagedTraceSpanEvidenceEvent": {
        "type": "object",
        "description": "Managed sink evidence envelope.",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stream": {
            "type": "string",
            "enum": [
              "trace_spans"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "$ref": "#/components/schemas/ManagedTraceSpanEvidence"
          }
        },
        "required": [
          "version",
          "id",
          "stream",
          "occurred_at",
          "data"
        ]
      }
    }
  }
}
