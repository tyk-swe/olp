{
  "paths": {
    "/api/v1/auth/capabilities": {
      "get": {
        "operationId": "authentication_capabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationCapabilities"
                }
              }
            },
            "description": "Public authentication capabilities"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "PostgreSQL unavailable"
          }
        },
        "security": [],
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/sessions": {
      "get": {
        "operationId": "list_sessions",
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size from 1 to 200; defaults to 50",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Owner-only user filter; defaults to the current user",
            "in": "query",
            "name": "user_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListResponse"
                }
              }
            },
            "description": "Active and unexpired sessions"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed query parameters, or an invalid cursor or page size"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Only owners can inspect another user's sessions"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "self"
            ]
          }
        ],
        "tags": [
          "sessions"
        ]
      },
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Session created"
          },
          "202": {
            "description": "Password verified; no session or recent grant is issued until MFA completes. Enrollment is required when the installation policy requires it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/MFAChallenge"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid credentials"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Local password sign-in is disabled"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation failed"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication work is rate limited"
          }
        },
        "security": [],
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/sessions/current": {
      "delete": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session ended and browser credentials expired"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Origin check failed"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "self"
            ]
          }
        ],
        "tags": [
          "sessions"
        ]
      },
      "get": {
        "operationId": "current_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Current session"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "No active session"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Another request recovered the session CSRF credential"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "self"
            ]
          }
        ],
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/sessions/{session_id}": {
      "delete": {
        "operationId": "revoke_session",
        "parameters": [
          {
            "description": "Session ID",
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Only owners can revoke another user's session"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Session not found"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "self"
            ]
          }
        ],
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthenticationCapabilities": {
        "properties": {
          "gateway_available": {
            "description": "Whether routing, provider configuration, and inference are available. Omitted by the reference backend.",
            "type": "boolean"
          },
          "limits_enforced": {
            "description": "Whether stored API key limits and cost budgets are enforced.",
            "type": "boolean"
          },
          "local_login_enabled": {
            "type": "boolean"
          },
          "notifications_active": {
            "description": "Whether the installation runs the notification delivery worker, so stored rules actually notify.",
            "type": "boolean"
          },
          "oidc_login_enabled": {
            "type": "boolean"
          },
          "retention_enforced": {
            "description": "Whether stored retention policies are applied by workers.",
            "type": "boolean"
          },
          "management_network_restricted": {
            "type": "boolean",
            "description": "Whether deployment CIDRs restrict console and management access before authentication."
          },
          "saml_login_enabled": {
            "type": "boolean"
          },
          "payload_capture_active": {
            "type": "boolean"
          },
          "response_cache_configured": {
            "type": "boolean",
            "description": "Whether this process is configured with a dedicated response cache. Does not report connection health."
          },
          "semantic_cache_vectors_unsealed": {
            "type": "boolean",
            "description": "Semantic caching indexes content-derived vectors without encryption; enabling it requires explicit acknowledgement. Response bodies remain encrypted."
          }
        },
        "required": [
          "local_login_enabled",
          "oidc_login_enabled",
          "notifications_active",
          "payload_capture_active"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "SessionDetailResponse": {
        "properties": {
          "browser_hint": {
            "description": "Coarse, untrusted browser/device display hint. An unrecognized user agent shows Unknown browser.",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "last_seen_at": {
            "description": "Time of the last session verification, updated at most once per minute.",
            "format": "date-time",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "current",
          "expires_at",
          "last_seen_at",
          "created_at"
        ],
        "type": "object"
      },
      "SessionListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionDetailResponse"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    }
  }
}
