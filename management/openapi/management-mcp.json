{
  "paths": {
    "/api/v1/mcp": {
      "post": {
        "operationId": "management_mcp",
        "summary": "Stateless management MCP over Streamable HTTP",
        "description": "Management-token only. Tools are generated from the management contract, filtered by current authority, and dispatched through the ordinary API handlers. Results omit secrets. Each call requires the same conditional headers, idempotency and project access as the API.",
        "tags": [
          "management-mcp"
        ],
        "security": [
          {
            "managementToken": [
              "access",
              "installation"
            ]
          },
          {
            "managementToken": [
              "access_read",
              "installation"
            ]
          },
          {
            "managementToken": [
              "configure"
            ]
          },
          {
            "managementToken": [
              "settings",
              "installation"
            ]
          },
          {
            "managementToken": [
              "keys"
            ]
          },
          {
            "managementToken": [
              "manage_organization"
            ]
          },
          {
            "managementToken": [
              "playground"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          },
          {
            "managementToken": [
              "usage"
            ]
          },
          {
            "managementToken": [
              "manage_projects",
              "installation"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "type": "string",
                    "const": "2.0"
                  },
                  "id": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result or error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "Notification accepted"
          },
          "401": {
            "description": "Management token required"
          },
          "403": {
            "description": "Token lacks authority"
          }
        }
      }
    }
  }
}
