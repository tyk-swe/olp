{
  "paths": {
    "/api/v1/media-jobs": {
      "get": {
        "operationId": "list_media_jobs",
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "api_key_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "provider_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "route",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lifecycle",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "created_after",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "created_before",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaJobListResponse"
                }
              }
            },
            "description": "Metadata-only asynchronous media job page"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Malformed query parameters, or an invalid cursor or page size"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Insufficient role"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid filter value or time range"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "tags": [
          "media-jobs"
        ]
      }
    },
    "/api/v1/media-jobs/{job_id}": {
      "get": {
        "operationId": "get_media_job",
        "parameters": [
          {
            "description": "UUIDv7 OLP media job ID",
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaJobItem"
                }
              }
            },
            "description": "Metadata-only asynchronous media job"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Media job not found"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "read"
            ]
          },
          {
            "managementToken": [
              "read"
            ]
          }
        ],
        "tags": [
          "media-jobs"
        ]
      },
      "delete": {
        "operationId": "delete_media_job",
        "parameters": [
          {
            "description": "UUIDv7 OLP media job ID",
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Current media-job ETag",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Provider delete confirmed and tombstone finalized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Media job not found or outside the caller's project scope"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Another worker holds the job or the provider delete is still pending"
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "ETag precondition failed"
          },
          "428": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "If-Match is required"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "configure"
            ]
          },
          {
            "managementToken": [
              "configure"
            ]
          }
        ],
        "summary": "Delete a media job's upstream artifact; cleanup, not generation cancellation",
        "tags": [
          "media-jobs"
        ]
      }
    },
    "/api/v1/media-jobs/{job_id}/refresh": {
      "post": {
        "operationId": "refresh_media_job",
        "parameters": [
          {
            "description": "UUIDv7 OLP media job ID",
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaJobItem"
                }
              }
            },
            "description": "Job after a synchronous reconciliation"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Media job not found or outside the caller's project scope"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Another worker holds a live claim on the job"
          }
        },
        "security": [
          {
            "csrfToken": [],
            "sessionCookie": [
              "configure"
            ]
          },
          {
            "managementToken": [
              "configure"
            ]
          }
        ],
        "tags": [
          "media-jobs"
        ]
      }
    },
    "/api/v1/media-jobs/{job_id}/content": {
      "get": {
        "operationId": "download_media_job_content",
        "parameters": [
          {
            "description": "UUIDv7 OLP media job ID",
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Content variant to download",
            "in": "query",
            "name": "variant",
            "required": true,
            "schema": {
              "enum": [
                "video",
                "thumbnail",
                "spritesheet"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Transient artifact stream; content is never persisted by this surface"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Media job not found or outside the caller's project scope"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "No downloadable content is available for this job or variant"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid content variant"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "configure"
            ]
          },
          {
            "managementToken": [
              "configure"
            ]
          }
        ],
        "tags": [
          "media-jobs"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MediaJobItem": {
        "properties": {
          "api_key_id": {
            "format": "uuid",
            "type": "string"
          },
          "completed_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "content_available": {
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "deleted_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "error_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "etag": {
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "last_polled_at": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "lifecycle": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "progress_percent": {
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "provider_id": {
            "format": "uuid",
            "type": "string"
          },
          "provider_model": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "reconciliation_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "upstream_job_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "api_key_id",
          "provider_id",
          "provider_name",
          "provider_model",
          "route",
          "operation",
          "surface",
          "state",
          "lifecycle",
          "content_available",
          "etag",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "MediaJobListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MediaJobItem"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      }
    }
  }
}
