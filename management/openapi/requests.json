          "usage_complete": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "origin": {
            "$ref": "#/components/schemas/RequestOrigin"
          },
          "parent_request_id": {
            "description": "The caller request a shadow or classifier request derives from.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "end_user_digest": {
            "description": "Project-scoped HMAC-SHA256 identity, or empty when not identified. Never the raw identifier.",
            "type": "string",
            "pattern": "^([0-9a-f]{64})?$"
          },
          "budget_boundary": {
            "type": "string",
            "enum": [
              "api_key",
              "budget_group",
              "key_route",
              "key_end_user",
              "project_end_user",
              "attribution",
              "project",
              "organization",
              "installation"
            ],
            "description": "Present for a cost-budget refusal: identifies the exhausted hierarchy level without retaining labels, digests or owner IDs."
          },
          "payload_captured": {
            "type": "boolean"
          },
          "audio_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "cached_audio_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "audio_output_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "image_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "cached_image_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "image_output_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "charge": {
            "description": "Sum of the request's attempt charges, an exact decimal string.",
            "type": [
              "string",
              "null"
            ]
          },
          "guardrail_decisions": {
            "type": "array",
            "items": {
              "$ref": "./shared.json#/components/schemas/GuardrailEvidence"
            },
            "maxItems": 512
          },
          "evaluator_guardrail_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "cache_result": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "hit",
              "semantic-hit",
              "miss",
              "bypass",
              null
            ]
          },
          "training_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "storage_byte_seconds": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact byte-seconds, without monetary rounding."
          },
          "cache_token_seconds": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact cached token-seconds."
          },
          "container_sessions": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "required": [
          "id",
          "runtime_generation_id",
          "api_key_id",
          "route",
          "operation",
          "surface",
          "started_at",
          "attempt_count",
          "attribution",
          "origin",
          "payload_captured"
        ],
        "type": "object"
      },
      "AttemptInteractionMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_state": {
            "type": "string",
            "enum": [
              "unobserved",
              "partially-observed",
              "actionable",
              "terminal"
            ]
          },
          "fidelity": {
            "type": "string",
            "enum": [
              "strict"
            ]
          },
          "plan_class": {
            "type": "string",
            "enum": [
              "native_identity",
              "qualified_interaction"
            ]
          },
          "upstream_state": {
            "type": "string",
            "enum": [
              "not-sent",
              "outcome-unknown",
              "accepted",
              "terminal"
            ]
          }
        },
        "required": [
          "fidelity",
          "plan_class",
          "upstream_state",
          "client_state"
        ],
        "description": "Metadata-only evidence distinguishing provider acceptance from client observation for strict interactions."
      },
      "RouteLeg": {
        "description": "The route that served an attempt when it is not the route the caller named.",
        "properties": {
          "route": {
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "type": "string"
          },
          "via": {
            "enum": [
              "fallback",
              "selector"
            ],
            "type": "string"
          }
        },
        "required": [
          "route",
          "revision_id",
          "via"
        ],
        "type": "object"
      },
      "RequestOrigin": {
        "description": "caller: an API key's request. shadow: a mirrored request. classifier: a selector's classification call. cache_embedding: a semantic-cache embedding call charged to the requesting key. probe: an active health probe. playground: a console member's Playground call. batch_settlement: one settled batch result, linked to the batch creation request and charged to its key. Shadow, probe and Playground requests belong to the installation and carry no key. retained_settlement: verified retained billing coverage linked to its original submission.",
        "enum": [
          "caller",
          "shadow",
          "classifier",
          "cache_embedding",
          "probe",
          "playground",
          "batch_settlement",
          "retained_settlement"
        ],
        "type": "string"
      },
      "ResponseCacheEvidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "hit",
              "semantic-hit"
            ]
          },
          "age_seconds": {
            "type": "integer",
            "format": "int64"
          },
          "similarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "currency": {
            "type": "string"
          },
          "avoided_cost": {
            "type": "string"
          },
          "budget_cost": {
            "type": "string"
          },
          "budget_charge": {
            "type": "string"
          }
        },
        "required": [
          "result",
          "age_seconds"
        ]
      },
      "PromptAttemptReference": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision_id"
        ],
        "type": "object"
      }
    }
  }
}
