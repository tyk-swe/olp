          },
          "cached_image_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "image_output_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "tool_calls": {
            "additionalProperties": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            },
            "description": "Metered server-side tool invocations by tool name.",
            "type": [
              "object",
              "null"
            ]
          },
          "batch": {
            "description": "The attempt's usage was produced at batch terms.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "pricing_components": {
            "description": "The price components the attempt was charged through.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "commitment_weight": {
            "description": "The list-cost weight the committed attempt divides its commitment period's amount by.",
            "type": [
              "string",
              "null"
            ]
          },
          "commitment_amount": {
            "description": "The commitment amount the attempt's provider owes per period.",
            "type": [
              "string",
              "null"
            ]
          },
          "commitment_period": {
            "description": "The UTC calendar period the commitment amount covers, when the attempt's provider is committed.",
            "type": [
              "string",
              "null"
            ]
          },
          "discount_id": {
            "description": "The discount the attempt was priced under, when one applied.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "charge": {
            "description": "What the attempt's consumer was billed, an exact decimal string.",
            "type": [
              "string",
              "null"
            ]
          },
          "rate_card_revision_id": {
            "description": "The rate card revision the charge came from, when a card applied.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "training_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "storage_byte_seconds": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact byte-seconds, without monetary rounding."
          },
          "cache_token_seconds": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact cached token-seconds."
          },
          "container_sessions": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          "invocation_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Verified generation/grader invocation count for deferred per-model usage."
          }
        },
        "required": [
          "id",
          "ordinal",
          "provider_id",
          "provider_name",
          "upstream_model",
          "started_at",
          "committed"
        ],
        "type": "object"
      },
      "AttemptRoutingMetadata": {
        "properties": {
          "credential_slot_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "credential_version_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "first_output_ms": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
