              "string",
              "null"
            ]
          },
          "provider_revision_id": {
            "format": "uuid",
            "type": "string"
          },
          "streamed_output_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "interaction": {
            "$ref": "#/components/schemas/AttemptInteractionMetadata"
          },
          "leg": {
            "$ref": "#/components/schemas/RouteLeg"
          },
          "selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "retry": {
            "description": "Same-target retry number of this attempt.",
            "minimum": 1,
            "type": [
              "integer",
              "null"
            ]
          },
          "budgets": {
            "description": "Route, connection and slot whose spend caps this attempt spent from.",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 3,
            "type": [
              "array",
              "null"
            ]
          },
          "credential_source": {
            "type": "string",
            "enum": [
              "operator",
              "caller"
            ],
            "description": "Absent means operator credentials. Caller attempts do not name an operator credential version."
          },
          "budget_exempt": {
            "type": "boolean",
            "description": "Caller-paid usage remains priced and reported but is excluded from cost budgets."
          },
          "cache": {
            "$ref": "#/components/schemas/ResponseCacheEvidence"
          },
          "prompt": {
            "$ref": "#/components/schemas/PromptAttemptReference"
          }
        },
        "required": [
          "provider_revision_id"
        ],
        "type": "object"
      },
      "RequestDetailResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RequestSummary"
          },
