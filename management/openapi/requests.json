          "strategy": {
            "$ref": "./shared.json#/components/schemas/RoutingStrategy"
          },
          "vendor_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "strategy",
          "digest"
        ],
        "type": "object"
      },
      "AttemptResponse": {
