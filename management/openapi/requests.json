              "integer",
              "null"
            ]
          },
          "unpriced": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "upstream_model": {
            "type": "string"
          },
          "usage_complete": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "usage_observed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "audio_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "cached_audio_input_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "audio_output_tokens": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "image_input_tokens": {
            "format": "int64",
            "minimum": 0,
