{
  "paths": {
    "/api/v1/requests": {
      "get": {
        "operationId": "list_requests",
        "parameters": [
          {
            "description": "Opaque cursor returned by the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Page size, from 1 to 200. Defaults to 50.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "route",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "provider_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "api_key_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "operation",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status_code",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "error_class",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "started_after",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "started_before",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Only usage carrying this attribution key. Requires attribution_value outside breakdowns.",
            "in": "query",
            "name": "attribution_key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only usage whose attribution_key carries this value. Requires attribution_key.",
            "in": "query",
            "name": "attribution_value",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "description": "Restrict to requests or usage owned by one project; the caller must already have access to it.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "description": "Restrict to records carrying attribution key 'session' with this value; conflicts with explicit attribution_key/attribution_value filters.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestListResponse"
                }
              }
            },
            "description": "Metadata-only request page"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid cursor or filter"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Insufficient role"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "usage"
            ]
          },
          {
            "managementToken": [
              "usage"
            ]
          }
        ],
        "tags": [
          "requests"
        ]
      }
    },
    "/api/v1/requests/{request_id}": {
      "get": {
        "operationId": "get_request",
        "parameters": [
          {
            "description": "UUIDv7 request ID",
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestDetailResponse"
                }
              }
            },
            "description": "Metadata timeline"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "./shared.json#/components/schemas/Problem"
                }
              }
            },
            "description": "Request not found"
          }
        },
        "security": [
          {
            "sessionCookie": [
              "usage"
            ]
          },
          {
            "managementToken": [
              "usage"
            ]
          }
        ],
        "tags": [
          "requests"
        ]
      }
    },
    "/api/v1/requests/export.csv": {
      "get": {
        "summary": "Export requests as CSV",
        "description": "Download the filtered request history as CSV. At most 10000 records and 32MiB; larger exports answer 422.",
        "tags": [
          "requests"
        ],
        "operationId": "exportRequestsCsv",
        "security": [
          {
            "sessionCookie": [
              "usage"
            ]
          },
          {
            "managementToken": [
              "usage"
            ]
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "route",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "provider_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "api_key_id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "operation",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status_code",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "error_class",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "started_after",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "started_before",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Only usage carrying this attribution key. Requires attribution_value outside breakdowns.",
            "in": "query",
            "name": "attribution_key",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only usage whose attribution_key carries this value. Requires attribution_key.",
            "in": "query",
            "name": "attribution_value",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "description": "Restrict to requests or usage owned by one project; the caller must already have access to it.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "description": "Restrict to records carrying attribution key 'session' with this value; conflicts with explicit attribution_key/attribution_value filters.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV export.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Export exceeds the bounded record or byte limit."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppliedRoutingPolicy": {
        "properties": {
          "digest": {
            "description": "SHA-256 of the effective policy inputs; request preferences are never persisted.",
