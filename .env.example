# Compose environment template. Full variable reference: docs/configuration.md
OLP_HOST_PORT=8080
POSTGRES_PASSWORD=olp
# Keep this percent-encoded form synchronized with POSTGRES_PASSWORD.
POSTGRES_PASSWORD_URL_ENCODED=olp
OLP_DATABASE_URL=postgres://olp:${POSTGRES_PASSWORD_URL_ENCODED}@postgres:5432/olp
OLP_DATABASE_MAX_CONNECTIONS=20
OLP_HTTP_MAX_CONNECTIONS=1024
OLP_HTTP_MAX_IN_FLIGHT_INFERENCE_REQUESTS=256
OLP_HTTP_MAX_IN_FLIGHT_MANAGEMENT_REQUESTS=32
OLP_HTTP_CONNECTION_MAX_AGE_SECONDS=300
OLP_HTTP_CONNECTION_DRAIN_TIMEOUT_SECONDS=30
OLP_VALKEY_URL=redis://valkey:6379
OLP_PUBLIC_ORIGIN=http://localhost:${OLP_HOST_PORT}
OLP_LOCAL_LOGIN_ENABLED=true
# Empty means X-Forwarded-For is ignored. Set to trusted reverse-proxy CIDRs.
OLP_TRUSTED_PROXY_CIDRS=
# Comma-separated browser origins allowed to call the gateway cross-origin.
OLP_GATEWAY_CORS_ALLOWED_ORIGINS=
# Empty keeps provider egress public-only over HTTPS. List private CIDRs and
# plain-HTTP hosts only for trusted on-premises upstreams.
OLP_PROVIDER_EGRESS_ALLOW_CIDRS=
OLP_PROVIDER_EGRESS_ALLOW_HTTP_HOSTS=
# Request body caps. The media cap must stay within half of the spool capacity.
OLP_HTTP_MAX_JSON_BODY_BYTES=2097152
OLP_HTTP_MAX_MEDIA_BODY_BYTES=67108864
OLP_HTTP_MAX_INLINE_MEDIA_ITEMS=4
OLP_HTTP_MAX_INLINE_MEDIA_ITEM_BYTES=1048576
OLP_HTTP_MAX_INLINE_MEDIA_TOTAL_BYTES=2097152
# Provider response caps; the event cap must not exceed the response cap.
OLP_PROVIDER_MAX_RESPONSE_BYTES=16777216
OLP_PROVIDER_MAX_EVENT_BYTES=1048576
OLP_MEDIA_SPOOL_CAPACITY_BYTES=1073741824
OLP_UID=1000
OLP_GID=1000
RUST_LOG=olp=info,tower_http=info
