# Optional Compose overrides. Every variable has a working default in deploy/compose.yaml.
# Full reference: docs/operate/configuration.md
OLP_HOST_PORT=8080
# Browser-facing URL. Defaults to http://localhost:${OLP_HOST_PORT}.
OLP_PUBLIC_ORIGIN=
# Published image. Empty keeps the pinned default.
OLP_IMAGE=
# Empty means X-Forwarded-For is ignored. Set to trusted reverse-proxy CIDRs.
OLP_TRUSTED_PROXY_CIDRS=
# Comma-separated browser origins allowed to call the gateway cross-origin.
OLP_GATEWAY_CORS_ALLOWED_ORIGINS=
# Empty keeps provider egress public-only over HTTPS. List private CIDRs and
# plain-HTTP hosts only for trusted on-premises upstreams.
OLP_PROVIDER_EGRESS_ALLOW_CIDRS=
OLP_PROVIDER_EGRESS_ALLOW_HTTP_HOSTS=
OLP_LOG_LEVEL=info

# Optional response cache: start Compose with --profile cache and set redis://cache:6379.
# Must name a separate Valkey instance, never another database on OLP_VALKEY_URL.
OLP_CACHE_VALKEY_URL=
