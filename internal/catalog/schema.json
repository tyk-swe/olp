{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openllmproxy.dev/schemas/catalog/v2.json",
  "title": "OpenLLMProxy reference catalog",
  "description": "Model facts and list prices by vendor, each entry with the documentation page and time it was observed. The catalog is advisory: it never certifies a model or prices an attempt on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "published_at", "currency", "estimation", "vendors"],
  "properties": {
    "api_version": { "const": "openllmproxy.dev/catalog/v2" },
    "published_at": { "$ref": "#/$defs/instant", "description": "Orders catalogs: a refresh never accepts an older one." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "estimation": { "type": "array", "items": { "$ref": "#/$defs/estimation" } },
    "vendors": { "type": "array", "items": { "$ref": "#/$defs/vendor" } }
  },
  "$defs": {
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{0,11}[1-9])?$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "observed_at"],
      "properties": {
        "source_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "observed_at": { "$ref": "#/$defs/instant" }
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "factor", "provenance"],
      "properties": {
        "family": { "enum": ["anthropic", "gemini", "other"] },
        "factor": { "$ref": "#/$defs/decimal" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "models"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "description": "An OLP vendor identifier." },
        "name": { "type": "string", "minLength": 1 },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } }
      }
    },
    "modality": { "enum": ["audio", "embeddings", "file", "image", "text", "video"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input_modalities", "output_modalities", "capabilities", "prices", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/modelId" },
        "aliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modelId" } },
        "canonical_model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "context_length": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "input_modalities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modality" } },
        "output_modalities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modality" } },
        "supported_parameters": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": { "type": "boolean" },
            "structured_outputs": { "type": "boolean" },
            "reasoning": { "type": "boolean" },
            "prompt_caching": { "type": "boolean" }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance"],
          "anyOf": [{ "required": ["deprecated_at"] }, { "required": ["retires_at"] }],
          "properties": {
            "deprecated_at": { "$ref": "#/$defs/date" },
            "retires_at": { "$ref": "#/$defs/date" },
            "replacement": { "type": "string", "minLength": 1 },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "prices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/price" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "modelId": { "type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9._:/@+-]{0,255}$" },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "unrepresentable", "provenance"],
      "anyOf": [
        { "required": ["input_per_million"] },
        { "required": ["output_per_million"] },
        { "required": ["audio_input_per_million"] },
        { "required": ["audio_output_per_million"] },
        { "required": ["image_input_per_million"] },
        { "required": ["image_output_per_million"] },
        { "required": ["unit_price"] },
        { "required": ["per_request"] },
        { "required": ["tool_calls"] }
      ],
      "dependentRequired": {
        "cached_input_per_million": ["input_per_million"],
        "cache_write_input_per_million": ["input_per_million"],
        "cache_write_5m_input_per_million": ["input_per_million"],
        "cache_write_1h_input_per_million": ["input_per_million"]
      },
      "properties": {
        "operation": {
          "enum": ["generation", "embeddings", "rerank", "moderation", "image_generation", "image_edit", "speech", "transcription", "translation", "video_create"]
        },
        "input_per_million": { "$ref": "#/$defs/decimal" },
        "cached_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_5m_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_1h_input_per_million": { "$ref": "#/$defs/decimal" },
        "output_per_million": { "$ref": "#/$defs/decimal" },
        "audio_input_per_million": { "$ref": "#/$defs/decimal", "description": "Rate for the audio share of the input tokens. Omit to bill audio input at the input rate." },
        "cached_audio_input_per_million": { "$ref": "#/$defs/decimal", "description": "Rate for the cached share of audio input tokens." },
        "audio_output_per_million": { "$ref": "#/$defs/decimal", "description": "Rate for the audio share of the output tokens." },
        "image_input_per_million": { "$ref": "#/$defs/decimal", "description": "Rate for the image share of the input tokens; video input is metered as image." },
        "cached_image_input_per_million": { "$ref": "#/$defs/decimal", "description": "Rate for the cached share of image input tokens." },
        "image_output_per_million": { "$ref": "#/$defs/decimal", "description": "Rate for the image share of the output tokens." },
        "unit_price": { "$ref": "#/$defs/decimal", "description": "Price of one media unit: an image, a second of audio or video, a character of speech input, or a search unit." },
        "per_request": { "$ref": "#/$defs/decimal", "description": "A fixed fee charged once per successful attempt." },
        "tool_calls": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/decimal" },
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "minProperties": 1,
          "maxProperties": 16,
          "description": "Fees per metered server-side tool invocation."
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tier" },
          "description": "Input-token tiers, ascending by above_input_tokens. A tier names the same per-million rates as its entry."
        },
        "windows": { "$ref": "#/$defs/windows" },
        "batch_multiplier": { "$ref": "#/$defs/decimal", "description": "Multiplies the whole usage charge of usage marked batch." },
        "unrepresentable": {
          "type": "array",
          "description": "Every price component the vendor charges that OLP cannot yet price, in the vendor's own terms.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "detail"],
            "properties": {
              "component": {
                "enum": ["ambiguous", "batch_rates", "cache_storage", "conditions", "free_allowance", "holiday_calendar", "media_units", "minimum_charge", "plan_pricing", "prepaid_credits", "promotion", "regional_uplift", "service_tier", "thinking_mode", "tool_usage", "unpublished_rates", "video_input"]
              },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["above_input_tokens"],
      "properties": {
        "above_input_tokens": { "type": "integer", "minimum": 1 },
        "input_per_million": { "$ref": "#/$defs/decimal" },
        "cached_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_5m_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_1h_input_per_million": { "$ref": "#/$defs/decimal" },
        "output_per_million": { "$ref": "#/$defs/decimal" },
        "audio_input_per_million": { "$ref": "#/$defs/decimal" },
        "cached_audio_input_per_million": { "$ref": "#/$defs/decimal" },
        "audio_output_per_million": { "$ref": "#/$defs/decimal" },
        "image_input_per_million": { "$ref": "#/$defs/decimal" },
        "cached_image_input_per_million": { "$ref": "#/$defs/decimal" },
        "image_output_per_million": { "$ref": "#/$defs/decimal" }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_zone", "periods"],
      "properties": {
        "time_zone": { "type": "string", "minLength": 1, "description": "An IANA time zone such as America/New_York." },
        "periods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["days", "start", "end", "multiplier"],
            "properties": {
              "days": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 7 } },
              "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$" },
              "multiplier": { "$ref": "#/$defs/decimal" }
            }
          }
        }
      }
    }
  }
}
