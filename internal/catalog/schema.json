{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openllmproxy.dev/schemas/catalog/v1.json",
  "title": "OpenLLMProxy reference catalog",
  "description": "Model facts and list prices by vendor, each entry with the documentation page and time it was observed. The catalog is advisory: it never certifies a model or prices an attempt on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "published_at", "currency", "estimation", "vendors"],
  "properties": {
    "api_version": { "const": "openllmproxy.dev/catalog/v1" },
    "published_at": { "$ref": "#/$defs/instant", "description": "Orders catalogs: a refresh never accepts an older one." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "estimation": { "type": "array", "items": { "$ref": "#/$defs/estimation" } },
    "vendors": { "type": "array", "items": { "$ref": "#/$defs/vendor" } }
  },
  "$defs": {
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{0,11}[1-9])?$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "observed_at"],
      "properties": {
        "source_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "observed_at": { "$ref": "#/$defs/instant" }
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "factor", "provenance"],
      "properties": {
        "family": { "enum": ["anthropic", "gemini", "other"] },
        "factor": { "$ref": "#/$defs/decimal" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "models"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$", "description": "An OLP vendor identifier." },
        "name": { "type": "string", "minLength": 1 },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } }
      }
    },
    "modality": { "enum": ["audio", "embeddings", "file", "image", "text", "video"] },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input_modalities", "output_modalities", "capabilities", "prices", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/modelId" },
        "aliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modelId" } },
        "canonical_model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "context_length": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "input_modalities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modality" } },
        "output_modalities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/modality" } },
        "supported_parameters": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools": { "type": "boolean" },
            "structured_outputs": { "type": "boolean" },
            "reasoning": { "type": "boolean" },
            "prompt_caching": { "type": "boolean" }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provenance"],
          "anyOf": [{ "required": ["deprecated_at"] }, { "required": ["retires_at"] }],
          "properties": {
            "deprecated_at": { "$ref": "#/$defs/date" },
            "retires_at": { "$ref": "#/$defs/date" },
            "replacement": { "type": "string", "minLength": 1 },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        },
        "prices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/price" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "modelId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "unrepresentable", "provenance"],
      "anyOf": [
        { "required": ["input_per_million"] },
        { "required": ["output_per_million"] },
        { "required": ["unit_price"] }
      ],
      "dependentRequired": {
        "cached_input_per_million": ["input_per_million"],
        "cache_write_input_per_million": ["input_per_million"],
        "cache_write_5m_input_per_million": ["input_per_million"],
        "cache_write_1h_input_per_million": ["input_per_million"]
      },
      "properties": {
        "operation": {
          "enum": ["generation", "embeddings", "rerank", "moderation", "image_generation", "image_edit", "speech", "transcription", "translation", "video_create"]
        },
        "input_per_million": { "$ref": "#/$defs/decimal" },
        "cached_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_5m_input_per_million": { "$ref": "#/$defs/decimal" },
        "cache_write_1h_input_per_million": { "$ref": "#/$defs/decimal" },
        "output_per_million": { "$ref": "#/$defs/decimal" },
        "unit_price": { "$ref": "#/$defs/decimal", "description": "Price of one media unit: an image, a second of audio or video, a character of speech input, or a search unit." },
        "unrepresentable": {
          "type": "array",
          "description": "Every price component the vendor charges that OLP cannot yet price, in the vendor's own terms.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "detail"],
            "properties": {
              "component": {
                "enum": ["tiers", "audio_input_per_million", "audio_output_per_million", "image_input_per_million", "image_output_per_million", "per_request", "tool_calls", "windows", "batch_multiplier", "service_tier", "regional_uplift", "cache_storage", "media_units"]
              },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
