{
  "items": [
    {
      "kind": "openai",
      "label": "OpenAI",
      "description": "OpenAI platform API with Chat Completions and Responses.",
      "default_auth_mode": "api_key",
      "auth_modes": [
        {
          "mode": "api_key",
          "label": "API key",
          "credential": "required"
        },
        {
          "mode": "headers",
          "label": "Encrypted headers",
          "credential": "required"
        },
        {
          "mode": "none",
          "label": "No credential",
          "credential": "forbidden"
        }
      ],
      "fields": [
        {
          "field": "endpoint",
          "label": "Endpoint",
          "required": false
        }
      ],
      "presets": []
    },
