  "query": "SELECT r.id, r.slug, r.created_at, (SELECT rr.id FROM route_revisions rr WHERE rr.route_id = r.id ORDER BY rr.revision DESC LIMIT 1) AS latest_revision_id, (SELECT count(*) FROM route_revisions rr WHERE rr.route_id = r.id)::bigint AS \"revision_count!\" FROM routes r WHERE ($1::uuid IS NULL OR r.id > $1) ORDER BY r.id LIMIT $2",
