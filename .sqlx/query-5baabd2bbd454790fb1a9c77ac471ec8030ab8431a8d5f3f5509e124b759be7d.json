  "query": "SELECT task, checked_at, last_success_at, last_progress_at, successes_total, failures_total, skipped_total, GREATEST(0, floor(extract(epoch FROM clock_timestamp() - checked_at)))::bigint AS \"heartbeat_age_seconds!\", CASE WHEN last_success_at IS NULL THEN NULL ELSE GREATEST(0, floor(extract(epoch FROM clock_timestamp() - last_success_at)))::bigint END AS last_success_age_seconds FROM worker_task_health ORDER BY task",
