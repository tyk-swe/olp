  "query": "INSERT INTO projects (id, team_id, name, etag, created_by, created_at, updated_at) SELECT $1, team.id, $3, $4, $5, $6, $6 FROM teams team WHERE team.id = $2 AND team.active RETURNING id, team_id, name, active, etag, created_by, created_at, updated_at",
