  "query": "INSERT INTO invitations (id, email, role, token_digest, invited_by, expires_at, created_at) VALUES ($1, $2, CAST($3::text AS user_role), $4, $5, $6, $7) RETURNING id, email, role::text AS \"role!\", invited_by, expires_at, accepted_at, revoked_at, expired_at, created_at, (SELECT u.email FROM users u WHERE u.id = invitations.invited_by) AS \"invited_by_email?\", (SELECT u.email FROM users u WHERE u.id = invitations.accepted_by) AS \"accepted_by_email?\", (SELECT u.email FROM users u WHERE u.id = invitations.revoked_by) AS \"revoked_by_email?\"",
