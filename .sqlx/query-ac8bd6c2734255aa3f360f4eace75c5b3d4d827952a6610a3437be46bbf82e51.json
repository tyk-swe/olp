{
  "db_name": "PostgreSQL",
  "query": "UPDATE service_accounts account SET name = COALESCE($2, account.name), active = COALESCE($3, account.active), etag = $4, updated_at = now() FROM projects project JOIN teams team ON team.id = project.team_id WHERE account.id = $1 AND account.etag = $5 AND project.id = account.project_id AND ($3::boolean IS DISTINCT FROM true OR (project.active AND team.active)) RETURNING account.id, account.team_id, account.project_id, account.name, account.active, account.etag, account.created_by, account.created_at, account.updated_at",
