  "query": "UPDATE invitations SET revoked_at = now(), revoked_by = $2 WHERE id = $1 AND accepted_at IS NULL AND revoked_at IS NULL AND expired_at IS NULL RETURNING id, email, role::text AS \"role!\", invited_by, expires_at, accepted_at, revoked_at, expired_at, created_at, (SELECT u.email FROM users u WHERE u.id = invitations.invited_by) AS \"invited_by_email?\", (SELECT u.email FROM users u WHERE u.id = invitations.accepted_by) AS \"accepted_by_email?\", (SELECT u.email FROM users u WHERE u.id = invitations.revoked_by) AS \"revoked_by_email?\"",
