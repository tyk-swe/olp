  "query": "SELECT owner_active, claimed_rows, checked_at, last_progress_at, GREATEST(0, floor(extract(epoch FROM clock_timestamp() - checked_at)))::bigint AS \"heartbeat_age_seconds!\", CASE WHEN last_progress_at IS NULL THEN NULL ELSE GREATEST(0, floor(extract(epoch FROM clock_timestamp() - last_progress_at)))::bigint END AS last_progress_age_seconds FROM runtime_outbox_health WHERE singleton",
