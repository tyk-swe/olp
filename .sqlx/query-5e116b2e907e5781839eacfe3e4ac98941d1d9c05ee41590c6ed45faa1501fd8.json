  "db_name": "PostgreSQL",
  "query": "SELECT i.id, i.email, i.role::text AS \"role!\", i.invited_by, i.expires_at, i.accepted_at, i.revoked_at, i.expired_at, i.created_at, inviter.email AS \"invited_by_email?\", accepter.email AS \"accepted_by_email?\", revoker.email AS \"revoked_by_email?\" FROM invitations i LEFT JOIN users inviter ON inviter.id = i.invited_by LEFT JOIN users accepter ON accepter.id = i.accepted_by LEFT JOIN users revoker ON revoker.id = i.revoked_by WHERE ($1::uuid IS NULL OR i.id < $1) ORDER BY i.id DESC LIMIT $2",
