  "db_name": "PostgreSQL",
  "query": "UPDATE projects project SET name = COALESCE($2, project.name), active = COALESCE($3, project.active), etag = $4, updated_at = now() FROM teams team WHERE project.id = $1 AND project.etag = $5 AND team.id = project.team_id AND ($3::boolean IS DISTINCT FROM true OR team.active) RETURNING project.id, project.team_id, project.name, project.active, project.etag, project.created_by, project.created_at, project.updated_at",
