  "query": "INSERT INTO service_accounts (id, team_id, project_id, name, etag, created_by, created_at, updated_at) SELECT $1, project.team_id, project.id, $4, $5, $6, $7, $7 FROM projects project JOIN teams team ON team.id = project.team_id WHERE project.id = $3 AND project.team_id = $2 AND project.active AND team.active RETURNING id, team_id, project_id, name, active, etag, created_by, created_at, updated_at",
